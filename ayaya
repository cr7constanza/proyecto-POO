    def agregar_vehiculo(self):
        self.limpiar_ventana()
        tk.Label(self.root, text="Agregar vehículo", font=("Arial", 14)).pack(pady=10)

        # Obtenemos las tiendas disponibles desde los datos
        tiendas_disponibles = list(datos["tiendas"].keys())
        # Creamos una variable para guardar la tienda seleccionada
        tienda_seleccionada_var = tk.StringVar()
        tienda_seleccionada_var.set(tiendas_disponibles[0])  # Valor por defecto


        # Creamos un marco para la tienda y añadimos el label y el desplegable
        frame_tienda = tk.Frame(self.root)
        frame_tienda.pack(pady=5)
        tk.Label(frame_tienda, text="Seleccionar tienda:", width=15, anchor="w").pack(side="left")
        tk.OptionMenu(frame_tienda, tienda_seleccionada_var, *tiendas_disponibles).pack(side="left", fill="x")

        # Creamos un diccionario de campos para el vehículo y sus variables de entrada
        campos = {campo: tk.StringVar() for campo in [
            "Marca", "Modelo", "Precio",  "Año", "Transmision", "Combustible",
            "Cilindrada", "Kilometraje", "Puertas", "Capacidad", "Carroceria", "Color"
        ]}

        for campo, var in campos.items():
            fila = tk.Frame(self.root)
            fila.pack(pady=2)
            tk.Label(fila, text=f"{campo}:", width=15, anchor="w").pack(side="left")
            tk.Entry(fila, textvariable=var, width=40).pack(side="left", fill="x")

        # Función que se ejecutará al presionar el botón "Guardar vehículo"
        def guardar():
            nuevo_vehiculo = {}
            # Iteramos sobre los campos, tomando el valor de cada uno
            for campo_original, var in campos.items():
                campo = campo_original.lower()# Convertimos la clave a minúscula para consistencia
                valor = var.get().strip()# Obtenemos el valor, eliminando espacios en blanco
                if not valor:# Si el campo está vacío, mostramos un error
                    messagebox.showerror("Error", f"El campo '{campo_original}' no puede estar vacío.")
                    return
                # Validamos campos numéricos como precio, puertas, capacidad y año
                if campo in ["precio", "puertas", "capacidad", "año"]:
                    if not valor.isdigit():# Si no es un número, mostramos un error
                        messagebox.showerror("Error", f"El campo '{campo_original}' debe ser un número.")
                        return
                    if campo == "año":# El campo 'año' se convierte a entero
                        nuevo_vehiculo["año"] = int(valor)
                    else:
                        nuevo_vehiculo[campo] = int(valor)

                # Validación para la cilindrada, que debe ser un número seguido de "L"
                
                elif campo == "cilindrada":
                    try:
                        float(valor.replace("L", "").strip())# Intentamos convertirlo a float
                        if not valor.endswith("L"):# Si no termina con "L", lo añadimos
                            valor = valor.replace("L", "").strip() + "L"
                        nuevo_vehiculo[campo] = valor
                    except ValueError:# Si no es un número válido, mostramos un error
                        messagebox.showerror("Error", "Cilindrada debe ser un número (ej. 1.6L)")
                        return
                # Validación para kilometraje, que debe ser un número seguido de " km"
                elif campo == "kilometraje":
                    try:
                        int(valor.replace("km", "").replace(" ", ""))# Intentamos convertirlo a int
                        if not valor.endswith("km"): # Si no termina con "km", lo añadimos
                            valor = valor.replace("km", "").replace(" ", "") + " km"
                        nuevo_vehiculo[campo] = valor
                    except ValueError:# Si no es un número válido, mostramos un error
                        messagebox.showerror("Error", "kilometraje debe ser un número seguido de ' km'")
                        return
                # Validación para los campos que solo deben contener letras (Marca, Modelo, etc.)
                else:
                    if not re.fullmatch(r"[A-Za-zÁÉÍÓÚÑáéíóúñ ]+", valor):
                        messagebox.showerror("Error", f"el campo '{campo_original}' solo debe contener letras.")
                        return
                    nuevo_vehiculo[campo] = valor
            # Obtenemos la tienda seleccionada desde el desplegable
            tienda_destino = tienda_seleccionada_var.get()
            # Verificamos si la tienda existe en los datos
            if tienda_destino in datos["tiendas"]:
                # Añadimos el vehículo a la tienda seleccionada
                datos["tiendas"][tienda_destino]["vehiculos"].append(nuevo_vehiculo)
                guardar_datos(datos)# Guardamos los cambios
                self.gestionar_vehiculos()  # Actualizamos la pantalla de vehículos
            else:
                messagebox.showerror("Error", "Tienda no válida.")  # Si la tienda no es válida, mostramos un error

        # Botón para guardar el vehículo
        tk.Button(self.root, text="Guardar vehículo", command=guardar).pack(pady=10)
        # Botón para volver a la pantalla de gestión de vehículos sin guardar cambios
        tk.Button(self.root, text="Volver", command=self.gestionar_vehiculos).pack(pady=5)


    def editar_vehiculo(self, vehiculo):
        self.limpiar_ventana()
        tk.Label(self.root, text="Editar vehículo", font=("Arial", 14)).pack(pady=10)

        # Título de la ventana para editar un vehículo

        tiendas_disponibles = list(datos["tiendas"].keys())

        # Buscar la tienda actual a la que pertenece el vehículo
        tienda_actual = None
        for tienda_nombre, tienda_info in datos["tiendas"].items():
            if vehiculo in tienda_info["vehiculos"]:
                tienda_actual = tienda_nombre
                break

        # Creamos un StringVar para la tienda seleccionada y le asignamos la tienda actual si existe
        
        tienda_seleccionada_var = tk.StringVar()
        tienda_seleccionada_var.set(tienda_actual if tienda_actual else tiendas_disponibles[0])

        # Creamos un marco para la tienda y añadimos el label y el desplegable
        frame_tienda = tk.Frame(self.root)
        frame_tienda.pack(pady=5)
        tk.Label(frame_tienda, text="Seleccionar tienda:", width=15, anchor="w").pack(side="left")
        tk.OptionMenu(frame_tienda, tienda_seleccionada_var, *tiendas_disponibles).pack(side="left")

        # Definimos las claves que estarán en los campos del vehículo
        claves_originales = [
            "Marca", "Modelo", "Precio", "Año", "Transmision", "Combustible",
            "Cilindrada", "Kilometraje", "Puertas", "Capacidad", "Carroceria", "Color"
        ]
        # Creamos un diccionario para los campos del vehículo, con el valor actual de cada uno
        campos = {}
        for clave_original in claves_originales:
            clave = clave_original.lower()
            campos[clave_original] = tk.StringVar(self.root, value=str(vehiculo.get(clave, "")))

        # Creamos un formulario similar al de agregar vehículo, pero con valores preexistentes
        for clave_original, var in campos.items():
            fila = tk.Frame(self.root)
            fila.pack(pady=2)
            tk.Label(fila, text=f"{clave_original}:", width=15, anchor="w").pack(side="left")
            tk.Entry(fila, textvariable=var, width=40).pack(side="left", fill="x")

        # Función para guardar los cambios del vehículo editado
        def guardar_cambios():
            for clave_original, var in campos.items():
                clave = clave_original.lower()
                valor = var.get().strip()
                if not valor:
                    messagebox.showerror("Error", f"el campo '{clave_original}' no puede estar vacío.")
                    return
                if clave in ["precio", "puertas", "capacidad", "año"]:
                    if not valor.isdigit():
                        messagebox.showerror("Error", f"el campo '{clave_original}' debe ser un número.")
                        return
                    vehiculo[clave] = int(valor)
                elif clave == "cilindrada":
                    try:
                        float(valor.replace("L", "").strip())
                        if not valor.endswith("L"):
                            valor = valor.replace("L", "").strip() + "L"
                        vehiculo[clave] = valor
                    except ValueError:
                        messagebox.showerror("Error", "cilindrada debe tener formato numérico, ej: 1.6L")
                        return
                elif clave == "kilometraje":
                    try:
                        int(valor.replace("km", "").replace(" ", ""))
                        if not valor.endswith("km"):
                            valor = valor.replace("km", "").replace(" ", "") + " km"
                        vehiculo[clave] = valor
                    except ValueError:
                        messagebox.showerror("Error", "kilometraje debe ser un número seguido de ' km'")
                        return
                else:
                    if not re.fullmatch(r"[A-Za-zÁÉÍÓÚÑáéíóúñ ]+", valor):
                        messagebox.showerror("Error", f"el campo '{clave_original}' solo debe contener letras.")
                        return
                    vehiculo[clave] = valor

            # Obtenemos la nueva tienda seleccionada
            nueva_tienda = tienda_seleccionada_var.get()
            
            # Si la tienda ha cambiado, movemos el vehículo a la nueva tienda
            if nueva_tienda != tienda_actual:
                if tienda_actual and vehiculo in datos["tiendas"][tienda_actual]["vehiculos"]:
                    datos["tiendas"][tienda_actual]["vehiculos"].remove(vehiculo)
                datos["tiendas"][nueva_tienda]["vehiculos"].append(vehiculo)

            guardar_datos(datos)# Guardamos los cambios
            self.gestionar_vehiculos()

        tk.Button(self.root, text="Guardar cambios", command=guardar_cambios).pack(pady=10)
        tk.Button(self.root, text="Cancelar", command=self.gestionar_vehiculos).pack()


